{"format":"flitware-template","formatVersion":1,"exportedAt":"2026-10-29T21:30:15.258Z","engine":{"name":"pdfme","version":"6.2.1"},"source":{"rootCollection":"fleets"},"template":{"name":"Certificado de ingresos del propietario","description":"Certificación de ingresos netos mensuales del propietario o afiliado.","root_collection":"fleets","template_type":"PDF","definition":{"basePdf":{"width":215.9,"height":279.4,"padding":[10,10,10,10]},"schemas":[[{"name":"date_line","type":"text","content":"$input.ciudad, $system.date","position":{"x":20,"y":15},"width":175.9,"height":8,"fontSize":10,"alignment":"left"},{"name":"dest","type":"text","content":"Señores\n$input.destinatario","position":{"x":20,"y":26},"width":175.9,"height":26,"fontSize":10,"alignment":"left"},{"name":"asunto","type":"text","content":"ASUNTO: CERTIFICADO DE INGRESOS","position":{"x":20,"y":55},"width":175.9,"height":12,"fontSize":12,"alignment":"left"},{"name":"saludo","type":"text","content":"Cordial saludo.","position":{"x":20,"y":70},"width":175.9,"height":8,"fontSize":10,"alignment":"left"},{"name":"body1","type":"text","content":"Por medio de la presente la empresa $tenant.name con NIT $tenant.legal_tax_id hace constar que $collection.owner, identificado(a) con $collection.owner_document_type.name número $collection.owner_document_number, es propietario(a) del 100% del vehículo tipo $collection.type.name de placa $collection.plate, con unos ingresos netos mensuales de $ $input.valor_ingresos ($input.valor_letras).","position":{"x":20,"y":80},"width":175.9,"height":42,"fontSize":11,"alignment":"justify"},{"name":"body2","type":"text","content":"Esta certificación se expide a solicitud del afiliado a través de los sistemas de la compañía; por lo tanto la utilización de la información en él es responsabilidad del mismo.","position":{"x":20,"y":124},"width":175.9,"height":26,"fontSize":11,"alignment":"justify"},{"name":"contact","type":"text","content":"Para validación y mayor información contactar al teléfono $tenant.phone en horario de oficina, también al correo electrónico $tenant.email.","position":{"x":20,"y":152},"width":175.9,"height":26,"fontSize":11,"alignment":"justify"},{"name":"closing","type":"text","content":"Cordialmente,","position":{"x":20,"y":190},"width":175.9,"height":8,"fontSize":10,"alignment":"left"},{"name":"sig_line","type":"line","position":{"x":20,"y":240},"width":80,"height":0.5},{"name":"sig_name","type":"text","content":"$tenant.legal_representative","position":{"x":20,"y":242},"width":100,"height":8,"fontSize":11,"alignment":"left"},{"name":"sig_role","type":"text","content":"Representante Legal","position":{"x":20,"y":250},"width":100,"height":7,"fontSize":10,"alignment":"left"},{"name":"sig_company","type":"text","content":"$tenant.name","position":{"x":20,"y":257},"width":100,"height":7,"fontSize":10,"alignment":"left"}]]},"settings":{"filenamePattern":"certificado-ingresos-$collection.plate","pageSize":"Letter","orientation":"portrait","templateFormatVersion":1,"engine":"pdfme","engineVersion":"6.2.1","allowPrint":true,"allowDownload":true,"inputs":[{"key":"ciudad","label":"Ciudad de expedición","type":"short_text","required":true,"config":{"max_length":100}},{"key":"destinatario","label":"Destinatario","description":"Una línea por renglón: nombre, cargo, entidad, ciudad.","type":"long_text","required":true,"config":{"max_length":500}},{"key":"valor_ingresos","label":"Valor de ingresos mensuales","type":"number","required":true,"config":{"min":0,"decimals":0}},{"key":"valor_letras","label":"Valor en letras","description":"Ej.: QUINIENTOS SESENTA Y SIETE MIL PESOS","type":"long_text","required":true,"config":{"max_length":500}}]}}}