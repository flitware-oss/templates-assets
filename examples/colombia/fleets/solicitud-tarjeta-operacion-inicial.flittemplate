{"format":"flitware-template","formatVersion":1,"exportedAt":"2026-10-29T21:30:15.262Z","engine":{"name":"pdfme","version":"6.2.1"},"source":{"rootCollection":"fleets"},"template":{"name":"Solicitud de tarjeta de operación inicial","description":"Solicitud de tarjeta de operación inicial del vehículo.","root_collection":"fleets","template_type":"PDF","definition":{"basePdf":{"width":215.9,"height":279.4,"padding":[10,10,10,10]},"schemas":[[{"name":"date_line","type":"text","content":"$input.ciudad, $system.date","position":{"x":20,"y":15},"width":175.9,"height":8,"fontSize":10,"alignment":"left"},{"name":"dest","type":"text","content":"Señores\n$input.destinatario","position":{"x":20,"y":26},"width":175.9,"height":26,"fontSize":10,"alignment":"left"},{"name":"asunto","type":"text","content":"ASUNTO: SOLICITUD TARJETA DE OPERACIÓN INICIAL","position":{"x":20,"y":55},"width":175.9,"height":12,"fontSize":12,"alignment":"left"},{"name":"saludo","type":"text","content":"Cordial saludo.","position":{"x":20,"y":70},"width":175.9,"height":8,"fontSize":10,"alignment":"left"},{"name":"body","type":"text","content":"$tenant.legal_representative, en calidad de representante legal de la empresa $tenant.name con NIT $tenant.legal_tax_id, dando cumplimiento al artículo 29 del Decreto 1079 de 2015 modificado por el Decreto 431 del 14 de marzo de 2017, solicita la tarjeta de operación del vehículo que a continuación se describe, el cual fue vinculado a nuestro parque automotor.","position":{"x":20,"y":80},"width":175.9,"height":48,"fontSize":11,"alignment":"justify"},{"name":"table_title","type":"text","content":"DESCRIPCIÓN DEL VEHÍCULO:","position":{"x":20,"y":132},"width":175.9,"height":8,"fontSize":11,"alignment":"left"},{"name":"row1_label","type":"text","content":"PLACA:","position":{"x":20,"y":142},"width":50,"height":7,"fontSize":10,"alignment":"left"},{"name":"row1_value","type":"text","content":"$collection.plate","position":{"x":72,"y":142},"width":123.9,"height":7,"fontS