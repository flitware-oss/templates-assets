{"customFields":[{"config":{"max_length":100},"key":"cargo","label":"Cargo","required":true,"type":"short_text"},{"key":"fecha_ingreso","label":"Fecha de ingreso","required":true,"type":"date"},{"config":{"decimals":0,"min":0},"key":"salario","label":"Salario mensual","type":"number"},{"config":{"max_length":60},"description":"Ej.: a término indefinido, a término fijo, por obra o labor, de prestación de servicios.","key":"tipo_contrato","label":"Tipo de contrato","type":"short_text"},{"config":{"max_length":100},"key":"ciudad","label":"Ciudad de expedición","type":"short_text"}],"engine":{"name":"pdfme","version":"6.2.1"},"exportedAt":"2026-10-29T00:00:00.000Z","format":"flitware-template","formatVersion":1,"source":{"rootCollection":"drivers"},"template":{"definition":{"basePdf":{"height":279.4,"padding":[10,10,10,10],"width":215.9},"schemas":[[{"alignment":"center","content":"$tenant.name","fontSize":16,"height":10,"name":"header_company","position":{"x":20,"y":15},"type":"text","width":175.9},{"alignment":"center","content":"NIT $tenant.legal_tax_id","fontSize":10,"height":8,"name":"header_nit","position":{"x":20,"y":25},"type":"text","width":175.9},{"alignment":"center","content":"$tenant.address · $tenant.phone · $tenant.email","fontSize":9,"height":8,"name":"header_contact","position":{"x":20,"y":33},"type":"text","width":175.9},{"height":0.5,"name":"divider_top","position":{"x":20,"y":43},"type":"line","width":175.9},{"alignment":"center","content":"CERTIFICACIÓN LABORAL","fontSize":15,"height":10,"name":"title","position":{"x":20,"y":50},"type":"text","width":175.9},{"alignment":"justify","content":"La suscrita $tenant.name, identificada con NIT $tenant.legal_tax_id, certifica que:","fontSize":11,"height":20,"name":"intro","position":{"x":20,"y":64},"type":"text","width":175.9},{"alignment":"justify","content":"El(la) señor(a) $collection.name, identificado(a) con $collection.document_type.name No. $collection.document_number, labora en esta empresa desde el